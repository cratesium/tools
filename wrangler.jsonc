// Cloudflare Pages configuration for UtilityHub.
// Static site output: `out/` (Next.js static export). Server-side endpoints: `functions/` (Pages Functions).
// Docs: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "utilityhub",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Optional: enables the URL Shortener (tool #286). Create the namespace with
  //   npx wrangler kv namespace create SHORT_LINKS
  // then uncomment and paste the returned id. Without it, /api/shorten returns 503 not_configured.
  // "kv_namespaces": [{ "binding": "SHORT_LINKS", "id": "<your-kv-namespace-id>" }],

  // Non-secret variables. Secrets (CF_API_TOKEN) are set in the dashboard or with
  //   npx wrangler pages secret put CF_API_TOKEN
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://utilityhub-4kt.pages.dev"
  }
}
