# Public base URL used for canonical URLs, sitemap and Open Graph tags (no trailing slash).
# Set this in Cloudflare Pages → Settings → Environment variables for Production and Preview.
NEXT_PUBLIC_SITE_URL=https://utilityhub.pages.dev

# --- Cloudflare Pages Functions (server-side, never exposed to the browser) ---
# Website Screenshot Tool (#288) uses the Cloudflare Browser Rendering REST API.
# Set these as encrypted secrets in Cloudflare (not in this file):
# CF_ACCOUNT_ID=
# CF_API_TOKEN=          # token with "Browser Rendering - Edit" permission

# URL Shortener (#286) needs a KV namespace bound as SHORT_LINKS (see wrangler.jsonc).
